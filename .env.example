# Copy to .env and fill in. .env is git-ignored; never commit real credentials.
NEXTCLOUD_HOST=https://cloud.example.com
NEXTCLOUD_USERNAME=
# Use a Nextcloud App Password, not your login password.
NEXTCLOUD_PASSWORD=

# Optional
# NEXTCLOUD_MCP_PERMISSIONS=read
# NEXTCLOUD_MCP_TRANSPORT=http
# NEXTCLOUD_MCP_HTTP_ADDR=127.0.0.1:8000
# Required in http mode, min 32 chars (e.g. openssl rand -hex 32).
# NEXTCLOUD_MCP_HTTP_TOKEN=
# Passthrough allowlist: comma-separated scheme://host[:port].
# NEXTCLOUD_MCP_ALLOWED_HOSTS=
# NEXTCLOUD_MCP_HTTP_TIMEOUT=
# NEXTCLOUD_MCP_PASSTHROUGH=
# NEXTCLOUD_MCP_MAX_LIST_ENTRIES=
# NEXTCLOUD_MCP_MAX_READ_BYTES=
# NEXTCLOUD_MCP_CB_THRESHOLD=
# NEXTCLOUD_MCP_CB_WINDOW=
